#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONPATH="$plugin_root/src${PYTHONPATH:+:$PYTHONPATH}"

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'papercuts requires Python 3.10 or later; python3 was not found on PATH' >&2
    exit 78
fi

if ! python3 -c '
import sys
if sys.version_info < (3, 10):
    version = ".".join(map(str, sys.version_info[:3]))
    print("papercuts requires Python 3.10 or later; found " + version + ". Update python3 on PATH.", file=sys.stderr)
    sys.exit(78)
'; then
    exit 78
fi

exec python3 -m papercuts.cli "$@"
