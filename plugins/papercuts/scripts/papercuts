#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONPATH="$plugin_root/src${PYTHONPATH:+:$PYTHONPATH}"

for python_command in python3 python3.14 python3.13 python3.12 python3.11; do
    if command -v "$python_command" >/dev/null 2>&1 &&
        "$python_command" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$python_command" -m papercuts.cli "$@"
    fi
done

printf '%s\n' 'papercuts requires Python 3.11 or later' >&2
exit 78
