#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONPATH="$plugin_root/src${PYTHONPATH:+:$PYTHONPATH}"

python_is_supported() {
    "$1" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

if python_is_supported python3; then
    exec python3 -m papercuts.cli "$@"
fi

old_ifs=$IFS
IFS=:
for directory in ${PATH:-}; do
    [ -n "$directory" ] || directory=.
    for python_command in "$directory"/python3.*; do
        [ -x "$python_command" ] || continue
        version=${python_command##*/python3.}
        case $version in
            '' | *[!0-9]*) continue ;;
        esac
        if python_is_supported "$python_command"; then
            exec "$python_command" -m papercuts.cli "$@"
        fi
    done
done
IFS=$old_ifs

printf '%s\n' 'papercuts requires Python 3.11 or later' >&2
exit 78
