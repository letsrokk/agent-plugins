{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/scripts/session_start.js')\"",
            "timeout": 5,
            "statusMessage": "Loading Papercuts instructions..."
          }
        ]
      }
    ]
  }
}
