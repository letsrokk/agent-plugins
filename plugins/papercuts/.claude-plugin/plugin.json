{
  "name": "papercuts",
  "version": "0.4.6",
  "description": "Keep a local record of tool failures, confusing instructions, and recurring workflow problems for later review.",
  "author": {
    "name": "Rokk Club",
    "url": "https://github.com/letsrokk"
  },
  "homepage": "https://github.com/letsrokk/agent-plugins",
  "repository": "https://github.com/letsrokk/agent-plugins",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "friction",
    "feedback",
    "developer-tools"
  ],
  "mcpServers": {
    "papercuts": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp_server.js"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "PAPERCUTS_CLIENT": "claude"
      }
    }
  }
}
